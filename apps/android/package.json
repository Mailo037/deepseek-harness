{
  "name": "@deepseek-ai/dsh-android",
  "description": "DeepSeek Harness Remote — Android thin client: QR pairing, WebView of the PC-served GUI, and a foreground WebSocket notification service",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cap:init": "cap init",
    "cap:sync": "cap sync android && node scripts/sync-native.mjs",
    "cap:open": "cap open android",
    "android:build": "pnpm build && pnpm cap:sync && node scripts/run-gradle.mjs assembleDebug",
    "android:build:release": "pnpm build && pnpm cap:sync && node scripts/run-gradle.mjs assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:^",
    "capacitor-barcode-scanner": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
