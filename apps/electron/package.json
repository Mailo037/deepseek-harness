{
  "name": "@deepseek-ai/dsh-electron",
  "description": "Electron desktop app over the dsh web profile: boots the same host as dsh web inside the Electron main process and renders the browser UI in a window, with a close grace that lets agents finish before the app exits",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/electron"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types",
    "config"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && electron .",
    "smoke": "tsc -b && node scripts/smoke-launch.mjs",
    "package:dir": "pnpm --dir ../.. run build:official && node scripts/package.mjs --dir --win --x64",
    "package:win": "pnpm --dir ../.. run build:official && node scripts/package.mjs --win --x64",
    "smoke:package": "pnpm run package:dir && node scripts/smoke-launch.mjs --packaged",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-agent-presets": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
